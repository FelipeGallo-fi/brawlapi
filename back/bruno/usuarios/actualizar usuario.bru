meta {
  name: actualizar usuario
  type: http
  seq: 4
}

put {
  url: http://localhost:3000/api/v1/usuario/:id
  body: json
  auth: none
}

params:path {
  id: 4
}

body:json {
  {
      "nombre": "NuevoNombre",
      "region": "EU",
      "edad": 26,
      "copas": 150,
      "brawlerFav": 3,  // Usa el ID del Brawler favorito
      "monedas": 600
    }
}
