
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://los_primos:sindolornohaygloria@localhost:5432/brawlapi"
}

model Usuario {
  id          Int    @id @default(autoincrement())
  nombre      String @unique 
  region      String
  edad        Int 
  copas       Int @default(0)
  brawlerFav  String
  monedas     Int @default(0)
}